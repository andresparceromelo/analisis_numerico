   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def euler(f,a,b,h,co):\n",
    "    n = int((b-a)/h)\n",
    "    w = [co]\n",
    "    for i in range(n):\n",
    "        w.append(w[i] + h * f(a + i *h, w[i]))\n",
    "    return np.linspace(a,b,n+1),w\n",
    "\n",
    "def f(t,y):\n",
    "    return t*np.exp(3*t) - 2*y\n",
    "\n"
   ]
  }
